<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">

    <!-- 1. Barra superior con título y acciones -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/demoToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="Demo Barra Superior"
        app:titleTextColor="@color/white"
        app:menu="@menu/menu_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/demoBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Contenedor con desplazamiento vertical -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/demoToolbar"
        app:layout_constraintBottom_toTopOf="@id/demoBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 4. Distribución en columna -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distribución en Fila y Pesos (LinearLayout)"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- 5. Distribución en fila y pesos proporcionales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Peso 1"
                    android:padding="16dp"
                    android:background="#FFCDD2"
                    android:gravity="center"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Peso 2 (Ocupa el doble)"
                    android:padding="16dp"
                    android:background="#C8E6C9"
                    android:gravity="center"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distribución Superpuesta (FrameLayout)"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- 6. Distribución superpuesta -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="24dp"
                android:background="#BBDEFB">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:text="Fondo"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="#1565C0"
                    android:layout_gravity="center" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="Frente"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="#FF8F00"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ejemplo con Restricciones (ConstraintLayout)"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- 7. Ejemplo de ConstraintLayout interno -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#E1BEE7">

                <TextView
                    android:id="@+id/centro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elemento Central"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anclado al centro"
                    app:layout_constraintTop_toBottomOf="@id/centro"
                    app:layout_constraintEnd_toEndOf="@id/centro" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>